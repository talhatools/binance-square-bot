# ==============================================================================
# Binance Square Automated Posting Bot - Configuration Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API KEYS (Keep secret, never commit to git!)
# ------------------------------------------------------------------------------
# Binance Square OpenAPI posting key (Must be POSTING-ONLY; no trading/withdrawal)
# Reference: https://www.binance.com/en/square
BINANCE_SQUARE_OPENAPI_KEY=your_binance_square_openapi_key_here

# Anthropic Claude API Key for drafting succinct, punchy market analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model to use (e.g., claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. OPERATIONAL CONTROLS
# ------------------------------------------------------------------------------
# DRY_RUN: When set to true, tests the scanner, chart generator, and AI analysis
# without actually uploading to Binance Square OpenAPI. Set to false for live posting.
DRY_RUN=true

# Schedule interval in minutes (Bot runs every 30 minutes = max 48 runs/day)
POST_INTERVAL_MINUTES=30

# Minimum 24-hour USDT quote volume to filter out illiquid low-cap coins (e.g. 10,000,000 USDT)
MIN_24H_QUOTE_VOLUME=10000000

# Cooldown period in hours: A coin will NOT be posted again within this duration
COOLDOWN_HOURS=6

# Daily Square post limit (Binance Square allows max 100/day, code 220009)
DAILY_POST_LIMIT=100

# Retries for external requests (Binance, Claude, Square OpenAPI)
MAX_RETRIES=3
RETRY_DELAY_BASE=2.0

# ------------------------------------------------------------------------------
# 3. WATERMARK & BRANDING
# ------------------------------------------------------------------------------
# Watermark displayed in the candlestick chart corner
WATERMARK_TEXT=Talha Sniper

# ------------------------------------------------------------------------------
# 4. ALERTS & LOGGING (Optional)
# ------------------------------------------------------------------------------
# Webhook URL for alerting on critical errors (codes 220003, 220004, 220009)
# Supports Discord or Slack webhook format
ALERT_WEBHOOK_URL=

# Telegram Bot alerts (Optional: sends error notifications and post updates to Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
